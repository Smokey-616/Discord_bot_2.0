[Unit]
Description=Discord Persona Chatbot Platform - Cloud Deployment
Documentation=https://github.com/your-org/discord-bot-2.0/wiki/Cloud-Deployment
After=network.target nss-lookup.target

# Start the bot ONLY on cloud servers!
# This should NEVER run on your personal computer!
ConditionPathExists=/app/Dockerfile

[Service]
Type=simple

# User running the service (cloud deployment only!)
User=ubuntu  # Change to your VPS user
Group=ubuntu

# Working directory
WorkingDirectory=/app

# Restart policy - AUTO-RESTART ON CRASH (99.9% uptime!)
Restart=always
RestartSec=10

# Environment variables
Environment="NODE_ENV=production"
Environment="DISCORD_BOT_TOKEN=your_encrypted_token_here"
Environment="OPENAI_API_KEY=your_openai_key_here"
Environment="MEMORY_WINDOW_SIZE=50"
Environment="AUTO_EXPIRE_HOURS=72"
Environment="EXPLICIT_CONTENT_MODE=fully_filtered"

# Working directory
WorkingDirectory=/app

# Node.js execution (production mode)
ExecStart=/usr/bin/node /app/index.js

# Health check endpoint (for cloud load balancers)
ExecReload=/bin/kill -s HUP $MAINPID

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
MemoryMax=512M
MemoryHigh=384M
CPUQuota=50%  # Limit to prevent runaway processes

# Logging (journalctl for systemd logs)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-persona-bot

# Prevent service from running on wrong server
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
