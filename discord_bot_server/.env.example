# =============================================
# DISCORD PERSONA CHATBOT - Environment Template
# =============================================
# CRITICAL: This bot MUST run on CLOUD SERVERS ONLY!
# NEVER deploy to your personal computer or laptop!
#
# Minimum Cloud Server Specs:
# - 2 vCPUs
# - 4GB RAM
# - SSD Storage
#
# Recommended Cloud Providers:
# - AWS EC2 (Ubuntu 20.04+)
# - Google Cloud Compute Engine
# - DigitalOcean Droplet
# - Any VPS provider

# =============================================
# DISCORD BOT TOKEN (FROM DEVELOPER PORTAL)
# =============================================
# Steps 1-4: Bot Creation Guide:
# 1. Open https://discord.com/developers/applications
# 2. Sign in and create "New Application"
# 3. Give it a name (e.g., "My Persona Bot")
# 4. Go to the "Bot" page in your application
# 5. Choose "Reset Token" and copy the new token
# 6. On that same Bot page, turn on "Message Content Intent" and save
#
# Store this encrypted token in your database!
DISCORD_BOT_TOKEN=your_encrypted_bot_token_here

# =============================================
# AI INTEGRATION
# =============================================
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o  # Options: gpt-4o, gpt-3.5-turbo, claude-3, llama-3

# =============================================
# MEMORY CONFIGURATION
# =============================================
MEMORY_WINDOW_SIZE=50  # Number of recent messages to remember (sliding window)
AUTO_EXPIRE_HOURS=72   # How long each message context persists before auto-expiry

# Optional: Enable memory compression for efficiency
MEMORY_COMPRESSION_ENABLED=false
MEMORY_SUMMARY_INTERVAL=100  # Summarize every N messages

# =============================================
# CONTENT FILTER MODE
# =============================================
# Options:
# - fully_filtered: No explicit content whatsoever, SFW-only responses
# - mature: Talks about explicit content when scene allows it, artistic/contextual
# - explicit: Full freedom, all content permitted when persona-appropriate
EXPLICIT_CONTENT_MODE=fully_filtered

# =============================================
# DATABASE CONFIGURATION
# =============================================
POSTGRES_URL=postgresql://user:password@localhost:5432/botdb
REDIS_URL=redis://localhost:6379

# Or use cloud databases:
# POSTGRES_URL=postgresql://user:pass@ep-abc123.us-east-1.aws.neon.tech/main
# REDIS_URL=redis://cluster-shard-00-masters.abcdef.upstash.io/

# =============================================
# AI SELF-IMPROVEMENT (OPTIONAL)
# =============================================
ENABLE_SELF_IMPROVEMENT=true
LEARNING_INTERVAL_HOURS=24  # Analyze conversations every N hours
SUCCESS_THRESHOLD=50  # Minimum successful interactions for learning

# =============================================
# MONITORING & ALERTS
# =============================================
HEARTBEAT_INTERVAL_MS=30000  # Send heartbeat to Discord every 30s
ALERT_EMAIL=admin@example.com  # Send crash alerts to this email
MONITORING_ENABLED=true

# =============================================
# CLOUD DEPLOYMENT FLAGS
# =============================================
NODE_ENV=production
PORT=3001  # Separate from Discord's websocket port (57299)

# Prevent running on personal computer:
FORCE_CLOUD_DEPLOYMENT=true
ALLOW_LOCALHOST=false
